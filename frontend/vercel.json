{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "corepack enable && corepack prepare pnpm@12.6.0 --activate && pnpm install --frozen-lockfile",
  "buildCommand": "VITE_USE_MOCKS=${VITE_USE_MOCKS:-true} VITE_MOCK_ME=${VITE_MOCK_ME:-engineer} pnpm build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
